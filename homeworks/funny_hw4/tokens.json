    {"name": "IF",        "regex": "if",        "skip": false},
    {"name": "ELSE",      "regex": "else",      "skip": false},
    {"name": "WHILE",     "regex": "while",     "skip": false},
    {"name": "INVARIANT", "regex": "invariant", "skip": false},
    {"name": "ASSERT",    "regex": "assert",    "skip": false},
    {"name": "ASSUME",    "regex": "assume",    "skip": false},
