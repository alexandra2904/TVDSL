// branches with short-circuit logic and loops
function classify(x: int) returns r: int {
    if (x > 0 and x < 100) {
        r = 1;
    } else {
        if (x == 0 or x < 0 - 100) { r = 2; } else { r = 3; }
    }
}

function sumTo(n: int) returns s: int uses i {
    s = 0;
    i = 1;
    while (i <= n) {
        s = s + i;
        i = i + 1;
    }
}

function scaled(n: int) returns s: int uses i, k {
    k = 2 * 3;
    s = 0;
    i = 0;
    while (i < n) {
        s = s + i * k + (1 - 1);
        i = i + 1;
    }
}
