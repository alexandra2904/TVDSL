digraph "scaled" {
  node [shape=record, fontname=Courier];
  "entry" [label="{entry:|k = 6\ls = 0\li = 0\ljump L1\l}"];
  "L1" [label="{L1:|%t1 = i \< n\lbr %t1, L2, L3\l}"];
  "L2" [label="{L2:|%t2 = i * k\l%t3 = s + %t2\ls = %t3\li = i + 1\ljump L1\l}"];
  "L3" [label="{L3:|ret s\l}"];
  "entry" -> "L1";
  "L1" -> "L2" [label="true"];
  "L1" -> "L3" [label="false"];
  "L2" -> "L1";
}
