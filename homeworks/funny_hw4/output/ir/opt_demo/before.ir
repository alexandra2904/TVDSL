function demo(x: int) returns (r: int)
  locals: a: int, b: int, dead: int
  temps: %t1: int, %t2: int, %t3: int, %t4: int
entry:    ; -> (выход)
    %t1 = 3 * 4
    a = 2 + %t1
    b = a + 0
    dead = x * 10
    %t2 = x * 1
    %t3 = %t2 + b
    r = %t3 - 0
    %t4 = 0 * x
    r = r + %t4
    ret r

function poly(x: int, y: int) returns (r: int)
  temps: %t1: int, %t2: int, %t3: int, %t4: int, %t5: int, %t6: int, %t7: int
entry:    ; -> (выход)
    %t1 = x + y
    %t2 = x - y
    %t3 = %t1 * %t2
    %t4 = x * 2
    %t5 = %t4 + y
    %t6 = y + 1
    %t7 = %t5 * %t6
    r = %t3 + %t7
    ret r

function constCond(x: int) returns (r: int)
  temps: %t1: int
entry:    ; -> L1, L3
    %t1 = 2 > 1
    br %t1, L1, L3
L1:    ; -> L2
    r = x + 1
    jump L2
L3:    ; -> L2
    r = x - 1
    jump L2
L2:    ; -> (выход)
    ret r
